// Markdown and TOML (`just dprint-check`). A template root is a generated project's: it checks its
// own (the smoke test runs its dprint), and its Liquid is not Markdown's, nor shared/template/'s,
// whose copies the templates check. The plugins at their latest (`just dprint-update`;
// dprint-plugins.yml, monthly), every template's versions.
{
  "markdown": {
    "textWrap": "maintain",
    // the plugin's defaults are underscores
    "emphasisKind": "asterisks",
    "strongKind": "asterisks"
  },
  // four spaces, as every template's (python's uv writes four: `uv add`): the TOML they share
  // passes each one's check (`just sync --check` holds the settings equal)
  "toml": { "indentWidth": 4 },
  "excludes": [
    // git-cliff's (cliff.toml): regenerated at each release, never edited
    "CHANGELOG.md",
    // `./`, this folder's alone: a bare `typst/` is every folder of that name (dev/typst/ too)
    "./typst/",
    "./python/",
    "./rust/",
    "./shared/template/",
    "./target/"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.26.0.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm"
  ]
}
