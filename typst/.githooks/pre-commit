#!/bin/sh
# What fails fastest, so a commit stays quick: the Typst code's format, the shell, the workflows
# (actionlint and zizmor), the imports' versions, dprint; the tests, the bundle's lint and the rest
# are `just checks` and CI. Checks the working tree, not just what is staged.
set -eu
just format-check shell-check actionlint zizmor versions-check dprint-check
