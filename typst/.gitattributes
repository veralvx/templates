# Every text file LF, as checked out on Windows too (core.autocrlf): a CRLF shebang does not run,
# and the formatters (shfmt, nixfmt, dprint, just's own) write LF, so their checks would refuse
# every line.
* text=auto eol=lf

# What typst/packages does not get: `just bundle` is `git archive`, which leaves out what is marked
# export-ignore here -- the tooling, the tests and the contributors' documents. What remains is the
# package: typst.toml, src/, template/ (a template package's), README.md, the licences, the
# changelog. A file a download need not hold, but the README links, stays here and goes in
# typst.toml's `exclude` instead.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.githooks export-ignore
/.github export-ignore
/tests export-ignore
/AGENTS.md export-ignore
/CITATION.cff export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
/cliff.toml export-ignore
/cog.toml export-ignore
/dprint.json export-ignore
/flake.lock export-ignore
/flake.nix export-ignore
/justfile export-ignore
/lychee.toml export-ignore
