# uv's environment, and what Python, the tools and the build leave behind
/.venv
__pycache__/
*.py[co]
/dist
/build
*.egg-info/
.coverage
.coverage.*
/htmlcov
.pytest_cache/
.ruff_cache/
.hypothesis/
# mutmut's mutants and their results (`just mutation`): the root's, or each member's
/mutants/
/packages/*/mutants/
# lychee's cache (`just links`)
/.lycheecache
# Nix's build links, direnv's cache
/result*
/.direnv
